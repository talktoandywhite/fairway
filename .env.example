# Fairway — environment variables.
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- App -------------------------------------------------------------------
# Canonical URL of this deployment. Used for auth redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# From `supabase start` (local) or the Supabase project settings (cloud).
# The anon key is public and safe to expose to the browser; RLS is the control.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never referenced in user-facing code paths — there is no
# service-role query path in this app (see CLAUDE.md). Present only for
# local tooling such as type generation and migrations.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) --------------------------------------------------------
# Server-only. Used to send the guardian consent email (lib/consent/email.ts).
# Leave RESEND_API_KEY empty in local/dev/CI: the app then logs the intended
# email instead of sending, so nothing real goes out and tests stay hermetic.
# In Vercel, set it as a Sensitive variable.
RESEND_API_KEY=
# The From address. Must be a Resend-verified sender to reach real inboxes;
# `onboarding@resend.dev` works only for a first test to your own address.
EMAIL_FROM="Fairway <onboarding@resend.dev>"
